# Enter provider API keys in the app's Settings so they are stored encrypted.

# Optional: Customize the Whisper model
# Available models: whisper-1 (default), whisper-1-large, whisper-1-large-v2
WHISPER_MODEL=whisper-1

# Optional: Set language for better transcription accuracy
# Leave empty for auto-detection, or use language codes like 'en', 'es', 'fr', etc.
LANGUAGE=

# Optional: UI language for app interface and menus (en, es, fr, de, pt, it)
UI_LANGUAGE=en

# Google Calendar: OAuth client type "Desktop app".
# The connection needs both values. Without them the app shows that Google Calendar
# is not configured. Manual recording and Apple Calendar work without them.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional: Debug mode
OPENWHISPR_LOG_LEVEL=debug
