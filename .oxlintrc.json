{
  "extends": ["./tools/typescript-quality/.oxlintrc.json"],
  "plugins": ["eslint", "typescript", "oxc", "react"],
  "jsPlugins": [
    {
      "name": "gristmill",
      "specifier": "./tools/oxlint/critical-write.mts"
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "tools/typescript-quality/**",
    ".tasks/**",
    "dist/**",
    "dist-dev/**",
    "dist-main/**",
    "src/dist/**",
    "build/**",
    "**/*.min.js",
    "test/scripts/type-probes/*-0?.ts",
    "test/**"
  ],
  "env": {
    "node": true,
    "browser": true
  },
  "rules": {
    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": false
      }
    ],
    "no-async-promise-executor": "error",
    "no-unsafe-finally": "error",
    "no-control-regex": "off",
    "react/globals": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/incompatible-library": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,cts,mts}"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": ["src/preload/ipcTransport.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off",
        "quality/no-runtime-typeof": "off"
      }
    },
    {
      "files": ["src/preload/*.ts", "preload.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/contracts/onnxWorker.ts"],
      "rules": {
        "quality/no-runtime-typeof": "off",
        "quality/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["test/helpers/harness/electronStub.ts"],
      "rules": {
        "quality/no-chained-type-assertions": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    {
      "files": ["test/helpers/harness/db.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["test/helpers/devRendererOriginElectron.ts"],
      "rules": {
        "quality/no-chained-type-assertions": "off"
      }
    },
    {
      "files": ["test/lib/rendererTestHarness.ts"],
      "rules": {
        "quality/no-chained-type-assertions": "off"
      }
    },
    {
      "files": ["src/helpers/database.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-runtime-typeof": "off",
        "quality/no-unsafe-dictionary-type": "off"
      }
    },
    // Notes/folder/action event senders: the payload arrives from JS-land
    // producers (meeting detection, CLI bridge, chat tools) before any schema
    // has run. Each sender validates it with its channel schema and drops a
    // malformed payload with a diagnostic; the unknown input is that contract.
    {
      "files": [
        "src/helpers/notesEvents.ts",
        "src/helpers/containerEvents.ts",
        "src/helpers/actionsEvents.ts"
      ],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // IPC handler modules: positional arguments and the DatabaseManager/notes
    // service results cross as honest unknown. Every handler parses its
    // arguments with the shared tuple schemas and its results with the shared
    // result schemas before any value reaches the renderer.
    {
      "files": [
        "src/helpers/containerIpcHandlers.ts",
        "src/helpers/actionsIpcHandlers.ts",
        "src/helpers/notesIpcHandlers.ts",
        "src/helpers/noteFilesIpcHandlers.ts"
      ],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    // Search text from the DatabaseManager.searchNotes boundary, which passes
    // the raw query through unchanged. Non-text input yields no FTS query, so
    // the text check stays at this boundary.
    {
      "files": ["src/helpers/noteSearch.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-runtime-typeof": "off"
      }
    },
    // Email display parsing for calendar/attendee UI: values historically
    // arrive from auth/contact rows typed as string, but the parser keeps the
    // runtime string check so malformed input degrades to "no domain"
    // instead of throwing at a render boundary.
    {
      "files": ["src/utils/personalEmailDomains.ts"],
      "rules": {
        "quality/no-runtime-typeof": "off"
      }
    },
    // Availability requests, event rows and attendee payloads arrive as
    // unknown JSON over the tool/IPC wire and from the events cache. The
    // parsers here branch on the decoded value's type and skip malformed
    // entries; the string checks are the boundary, not representation
    // narrowing of a typed value.
    {
      "files": ["src/helpers/calendarAvailability.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-runtime-typeof": "off",
        "quality/no-unsafe-dictionary-type": "off"
      }
    },
    // Outgoing calendar broadcast payloads are built from DB rows and
    // validated against the channel schema right here; unknown input is the
    // contract and malformed payloads are dropped with a diagnostic.
    {
      "files": ["src/helpers/calendarEvents.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Google conference_data arrives as stored JSON of an external schema;
    // the video entry-point reader guards every access and degrades to null,
    // matching the other calendar wire parsers.
    {
      "files": ["src/helpers/meetingJoinUrl.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Companion window IPC: the Electron event object carries the sender and
    // the load-failure catch logs thrown unknowns; incoming payloads are
    // schema-parsed (safeParse) before reaching the window, matching the
    // other ipcMain handler boundary exceptions.
    {
      "files": ["src/helpers/meetingCompanionWindow.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    // Chrome extension typings: the chrome.* messaging surface passes opaque
    // message values (sendMessage/onMessage/tabs.sendMessage) and storage
    // dictionaries by contract; receivers schema-parse (safeParse) every
    // message before use. The typing surface itself is the boundary.
    {
      "files": ["extension/src/chrome.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off",
        "quality/no-unsafe-dictionary-type": "off"
      }
    },
    // Companion frame codec: decoded native-messaging frames are honest
    // unknown until the receiver's schema parses them, and the writer
    // serializes schema-checked messages.
    {
      "files": ["src/helpers/companionFrames.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Auto-end lifecycle handlers receive the Electron invoke event and a
    // rest spread of raw arguments; each handler narrows the wire shape via
    // readAutoEndArguments before the engine call, matching the other ipcMain
    // handler boundary exceptions.
    {
      "files": ["src/helpers/meetingAutoEndLifecycle.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    // Calendar integration handlers receive unknown over ipcMain and log
    // thrown unknowns; every payload is schema-validated (parseOr/schema
    // .safeParse) before it reaches a manager, matching the other IPC
    // handler modules' boundary exceptions.
    {
      "files": ["src/helpers/calendarIpcHandlers.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off",
        "quality/no-runtime-typeof": "off"
      }
    },
    // Same ipcMain boundary as calendarIpcHandlers: the request is unknown
    // until the service validates it, and the response is schema-checked
    // before it crosses back to the renderer.
    {
      "files": ["src/helpers/calendarAvailabilityIpcHandler.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    // Coded failures arrive as thrown unknowns or returned results; the key
    // lookup parses only the optional string `code` before indexing.
    {
      "files": ["src/components/notes/shared.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Honest unknown at the JSON/HTTP request boundary: the decoded body and
    // its fields stay unknown until each route's schema or predicate validates
    // them before any domain call; responses are serialized opaque payloads.
    {
      "files": ["src/helpers/cliBridge.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off",
        "quality/no-unsafe-dictionary-type": "off",
        "quality/no-known-value-widening": "off"
      }
    },
    // Opaque log-meta transport boundary: callers pass arbitrary domain objects
    // that the sinks serialize. The legacy String() coercion is the observable
    // triage format (CUS-113), so `[object Object]` stringification is intended.
    {
      "files": ["src/helpers/debugLogger.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off",
        "quality/no-known-value-widening": "off",
        "typescript/no-base-to-string": "off"
      }
    },
    // Opaque renderer log-meta transport boundary: the same arbitrary-meta
    // contract as the main-process logger above.
    {
      "files": ["src/utils/logger.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Value parsers for untrusted app/OS input (versions, timestamps, env
    // errors): each accepts the honest unknown and returns a concrete type or a
    // documented fallback, so the unknown guards the boundary, not the business
    // logic.
    {
      "files": [
        "src/helpers/appVersion.ts",
        "src/helpers/dbTimestamp.ts",
        "src/helpers/devSnapshot.ts",
        "src/helpers/environment.ts",
        "src/helpers/secretCrypto.ts",
        "src/utils/version.ts",
        "src/utils/dateFormatting.ts"
      ],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Renderer-measured content heights cross the window boundary as plain
    // numbers; windowConfig coerces them with Number() and a finite fallback, so
    // the unknown input is bounded here before it reaches layout math.
    {
      "files": ["src/helpers/windowConfig.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Main-process broadcast boundary: the channel-specific payload is owned by
    // its sender's contract, and the preload parses it before any consumer runs.
    {
      "files": ["src/helpers/windowBroadcast.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    // Main-to-renderer IPC send boundary: the payload is optionally omitted and
    // is validated by the receiving preload bridge against its channel contract.
    {
      "files": ["src/helpers/windowManager.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/helpers/downloadUtils.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/utils/retry.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    {
      "files": [
        "src/helpers/audioTapManager.ts",
        "src/helpers/meetingRecordingStorage.ts",
        "src/stores/meetingRecordingStore.ts"
      ],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unsafe-dictionary-type": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/helpers/meetingSummary.ts"],
      "rules": {
        "quality/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": [
        "src/helpers/deepgramFileTranscription.ts",
        "src/helpers/elevenLabsFileTranscription.ts"
      ],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-known-value-widening": "off"
      }
    },
    {
      "files": ["src/helpers/ipcHandlers.ts"],
      "rules": {
        "quality/no-chained-type-assertions": "off",
        "quality/no-unknown-parameters": "off",
        "quality/no-unsafe-dictionary-type": "off"
      }
    },
    {
      "files": [
        "src/helpers/localFileTranscription.ts",
        "src/helpers/localFileTranscriptionIpcHandler.ts",
        "src/helpers/localModelLifecycleIpcHandlers.ts",
        "src/helpers/localLlmModelIpcHandlers.ts"
      ],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    },
    {
      "files": ["src/helpers/whisperVadConfig.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off"
      }
    },
    {
      "files": ["src/contracts/calendar.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-runtime-typeof": "off",
        "quality/no-unsafe-dictionary-type": "off",
        "quality/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      "files": [
        "**/src/*.{ts,tsx,js,jsx}",
        "**/src/components/**/*.{ts,tsx,js,jsx}",
        "**/src/hooks/**/*.{ts,tsx,js,jsx}",
        "**/src/stores/**/*.{ts,tsx,js,jsx}",
        "**/src/services/**/*.{ts,tsx,js,jsx}",
        "**/src/models/**/*.{ts,tsx,js,jsx}",
        "**/src/lib/**/*.{ts,tsx,js,jsx}"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:|electron(?:/|$)|(?:_http_agent|_http_client|_http_common|_http_incoming|_http_outgoing|_http_server|_stream_duplex|_stream_passthrough|_stream_readable|_stream_transform|_stream_wrap|_stream_writable|_tls_common|_tls_wrap|assert|assert/strict|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|dns/promises|domain|events|fs|fs/promises|http|http2|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|punycode|querystring|readline|readline/promises|repl|stream|stream/consumers|stream/promises|stream/web|string_decoder|sys|timers|timers/promises|tls|trace_events|tty|url|util|util/types|v8|vm|wasi|worker_threads|zlib|sea|sqlite|test|test/reporters)(?:/|$))",
                "message": "Renderer cannot import Node/Electron or main implementation. Use window.electronAPI, a shared contract, or an approved browser-safe helper."
              },
              {
                "regex": "(?:^|/)(?:preload/|workers/|utils/(?:process|serverUtils)(?:\\.[cm]?[jt]s)?$|localReasoningBridge(?:\\.[cm]?[jt]s)?$)|^(?:\\.\\./)+(?:main|preload)(?:\\.[cm]?[jt]s)?$",
                "message": "Renderer cannot import Node/Electron or main implementation. Use window.electronAPI, a shared contract, or an approved browser-safe helper."
              },
              {
                "group": [
                  "**/helpers/**",
                  "!**/helpers/activeMicRecovery",
                  "!**/helpers/agentToolPresentation",
                  "!**/helpers/builtinActions",
                  "!**/helpers/calendarAvailability",
                  "!**/helpers/calendarDescription",
                  "!**/helpers/chatRouting",
                  "!**/helpers/dictionaryImport",
                  "!**/helpers/dictionaryStartup",
                  "!**/helpers/geminiResponse",
                  "!**/helpers/llmRequestTimeout",
                  "!**/helpers/localASROrganization",
                  "!**/helpers/localModelSelections",
                  "!**/helpers/meetingAudioPipeline",
                  "!**/helpers/meetingClockSync",
                  "!**/helpers/meetingFileTranscription",
                  "!**/helpers/meetingFollowUpPrompt",
                  "!**/helpers/meetingJoinUrl",
                  "!**/helpers/meetingRecordingConfigSnapshot",
                  "!**/helpers/meetingRecordingRequest",
                  "!**/helpers/meetingRecordingSession",
                  "!**/helpers/micDeviceSelection",
                  "!**/helpers/micSelectionRecovery",
                  "!**/helpers/microphoneSelection",
                  "!**/helpers/noteFormattingOverrides",
                  "!**/helpers/reasoningRouting",
                  "!**/helpers/selfHostedTranscription",
                  "!**/helpers/speakerCount",
                  "!**/helpers/stripThinking",
                  "!**/helpers/transcriptionRoute",
                  "!**/helpers/activeMicRecovery.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/agentToolPresentation.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/builtinActions.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/calendarAvailability.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/calendarDescription.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/chatRouting.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/dictionaryImport.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/dictionaryStartup.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/geminiResponse.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/llmRequestTimeout.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/localASROrganization.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/localModelSelections.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingAudioPipeline.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingClockSync.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingFileTranscription.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingFollowUpPrompt.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingJoinUrl.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingRecordingConfigSnapshot.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingRecordingRequest.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/meetingRecordingSession.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/micDeviceSelection.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/micSelectionRecovery.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/microphoneSelection.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/noteFormattingOverrides.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/reasoningRouting.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/selfHostedTranscription.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/speakerCount.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/stripThinking.{js,jsx,ts,tsx,mjs,mts,cjs,cts}",
                  "!**/helpers/transcriptionRoute.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"
                ],
                "message": "Renderer cannot import Node/Electron or main implementation. Use window.electronAPI, a shared contract, or an approved browser-safe helper."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "process",
          "Buffer",
          "require",
          "module",
          "exports",
          "__dirname",
          "__filename"
        ],
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true
          }
        ],
        "gristmill/no-discarded-critical-write": "error"
      }
    },
    {
      "files": ["**/src/services/localReasoningBridge.ts", "**/src/eslint.config.js"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["**/extension/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:|electron(?:/|$)|(?:_http_agent|_http_client|_http_common|_http_incoming|_http_outgoing|_http_server|_stream_duplex|_stream_passthrough|_stream_readable|_stream_transform|_stream_wrap|_stream_writable|_tls_common|_tls_wrap|assert|assert/strict|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|dns/promises|domain|events|fs|fs/promises|http|http2|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|punycode|querystring|readline|readline/promises|repl|stream|stream/consumers|stream/promises|stream/web|string_decoder|sys|timers|timers/promises|tls|trace_events|tty|url|util|util/types|v8|vm|wasi|worker_threads|zlib|sea|sqlite|test|test/reporters)(?:/|$))",
                "message": "Renderer cannot import Node/Electron or main implementation. Use window.electronAPI, a shared contract, or an approved browser-safe helper."
              },
              {
                "group": ["**/helpers/**"],
                "message": "Companion cannot load main-process helpers."
              }
            ]
          }
        ],
        "no-restricted-globals": ["error", "process", "Buffer", "require", "__dirname"]
      }
    },
    {
      "files": ["src/helpers/meetingProcessing.ts"],
      "rules": {
        "quality/no-unknown-parameters": "off",
        "quality/no-unknown-returns": "off"
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
