{
  "appId": "com.khakhalev.gristmill",
  "beforeBuild": "scripts/beforeBuild.js",
  "afterPack": "scripts/afterPack.js",
  "productName": "Gristmill",
  "protocols": {
    "name": "Gristmill Protocol",
    "schemes": [
      "gristmill"
    ]
  },
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "dist-main/**/*",
    "package.json",
    "LICENSE",
    "docs/openwhispr-upstream/IMPORT.md",
    "node_modules/**/*",
    "src/dist/**/*",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",
    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",
    "!**/node_modules/postcss/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",
    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/tw-animate-css/**",
    "!**/node_modules/react-markdown/**",
    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**"
  ],
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**/*",
    "**/node_modules/ps-list/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/@napi-rs/keyring/**/*",
    "dist-main/src/workers/**/*"
  ],
  "extraResources": [
    {
      "from": "src/assets",
      "to": "src/assets",
      "filter": [
        "**/*",
        "!iconDev*"
      ]
    },
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": [
        "whisper-cpp-*",
        "whisper-server-*",
        "llama-server-*",
        "sherpa-onnx-*",
        "macos-audio-tap",
        "macos-globe-listener",
        "macos-mic-listener",
        "macos-meeting-ax",
        "macos-calendar-listener",
        "*.dylib"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "icon": "src/assets/icon.icns",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "extraResources": [
      {
        "from": "src/assets/Assets.car",
        "to": "Assets.car"
      }
    ],
    "extendInfo": {
      "LSUIElement": false,
      "CFBundleIconName": "gristmill",
      "NSMicrophoneUsageDescription": "Gristmill uses the microphone to capture your voice for transcription.",
      "NSAudioCaptureUsageDescription": "Gristmill uses system audio to capture other participants' audio from calls and meetings.",
      "NSAccessibilityUsageDescription": "Gristmill uses accessibility access for global meeting shortcuts.",
      "NSCalendarsUsageDescription": "Gristmill reads your calendar to detect upcoming meetings and link meeting notes to events.",
      "NSCalendarsFullAccessUsageDescription": "Gristmill reads your calendar to detect upcoming meetings and link meeting notes to events."
    }
  },
  "dmg": {
    "title": "Gristmill",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  }
}
