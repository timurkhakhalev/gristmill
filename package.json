{
  "name": "gristmill",
  "version": "1.10.2",
  "description": "A macOS meeting and notes application for local-first transcription",
  "main": "dist-main/main.js",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "ffmpeg-static",
      "onnxruntime-node"
    ],
    "overrides": {
      "adm-zip": "0.6.1",
      "@tiptap/extension-blockquote": "3.31.3",
      "@tiptap/extension-bold": "3.31.3",
      "@tiptap/extension-bubble-menu": "3.31.3",
      "@tiptap/extension-bullet-list": "3.31.3",
      "@tiptap/extension-code": "3.31.3",
      "@tiptap/extension-code-block": "3.31.3",
      "@tiptap/extension-document": "3.31.3",
      "@tiptap/extension-dropcursor": "3.31.3",
      "@tiptap/extension-floating-menu": "3.31.3",
      "@tiptap/extension-gapcursor": "3.31.3",
      "@tiptap/extension-hard-break": "3.31.3",
      "@tiptap/extension-heading": "3.31.3",
      "@tiptap/extension-horizontal-rule": "3.31.3",
      "@tiptap/extension-italic": "3.31.3",
      "@tiptap/extension-link": "3.31.3",
      "@tiptap/extension-list": "3.31.3",
      "@tiptap/extension-list-item": "3.31.3",
      "@tiptap/extension-list-keymap": "3.31.3",
      "@tiptap/extension-ordered-list": "3.31.3",
      "@tiptap/extension-paragraph": "3.31.3",
      "@tiptap/extension-strike": "3.31.3",
      "@tiptap/extension-text": "3.31.3",
      "@tiptap/extension-underline": "3.31.3",
      "@tiptap/extensions": "3.31.3",
      "@tiptap/pm": "3.31.3",
      "@xmldom/xmldom": "0.8.15",
      "fast-xml-builder": "1.2.0",
      "fast-xml-parser": "5.7.2",
      "ip-address": "10.2.0",
      "markdown-it": "14.2.0",
      "tmp": "0.2.7"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-native.cts globe",
    "compile:mic-listener": "node scripts/build-native.cts mic",
    "compile:meeting-ax": "node scripts/build-native.cts meeting-ax",
    "compile:calendar-listener": "node scripts/build-native.cts calendar",
    "compile:audio-tap": "node scripts/build-native.cts audio-tap",
    "compile:native": "node scripts/build-native.cts",
    "prestart": "pnpm run compile:native && pnpm run build:main",
    "start": "node scripts/run-electron.cts",
    "dev": "concurrently -k -r \"pnpm:dev:renderer\" \"pnpm:dev:main\"",
    "predev:main": "pnpm run compile:native && pnpm run build:main",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.cts --dev",
    "dev:renderer": "cd src && vite",
    "build": "pnpm run build:mac:arm64",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && cross-env VITE_GRISTMILL_DEV_BUILD=false vite build",
    "build:renderer:dev": "cd src && cross-env VITE_GRISTMILL_DEV_BUILD=true vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.cts",
    "prebuild:mac:arm64": "pnpm run compile:native && pnpm run compile:mac-icon",
    "build:mac:arm64": "pnpm run build:main && pnpm run build:companion && pnpm run build:renderer && electron-builder --mac --arm64",
    "build:mac:arm64:local": "pnpm run prebuild:mac:arm64 && pnpm run build:main && pnpm run build:companion && pnpm run build:renderer && electron-builder --mac --arm64 -c.mac.identity=\"Gristmill Local Signing\" -c.mac.notarize=false",
    "prepack": "pnpm run prebuild:mac:arm64",
    "pack": "pnpm run build:main && pnpm run build:companion && pnpm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir",
    "pack:dev": "node scripts/check-dev-app-build-target.cts && pnpm run prebuild:mac:arm64 && pnpm run build:main && pnpm run build:companion && pnpm run build:renderer:dev && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.dev.cjs --mac --arm64 --dir",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.cts --current",
    "download:llama-server": "node scripts/download-llama-server.cts --current",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.cts --current",
    "download:diarization-models": "node scripts/download-diarization-models.cts",
    "download:whisper-vad-model": "node scripts/download-whisper-vad-model.cts",
    "format:oxfmt:write": "oxfmt --write .",
    "format": "pnpm run format:oxfmt:write",
    "lint": "oxlint .",
    "knip": "knip",
    "test": "node scripts/run-tests.cts",
    "typecheck": "pnpm run typecheck:main && pnpm run typecheck:renderer && pnpm run typecheck:settings-selectors && pnpm run typecheck:tests && pnpm run typecheck:companion && pnpm run typecheck:scripts && pnpm run typecheck:lint-tools",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "i18n:check": "node scripts/check-i18n.cts",
    "build:main": "node scripts/build-main.cts",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p src/tsconfig.json --noEmit",
    "typecheck:settings-selectors": "tsc -p tsconfig.settings-selectors.json",
    "build:companion": "node scripts/build-companion.cts",
    "typecheck:companion": "tsc -p extension/tsconfig.json",
    "build:runtime-tools": "node scripts/build-runtime-tools.cts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "update:local": "node scripts/update-local.cts",
    "lint:fix": "oxlint . --fix",
    "lint:policy:test": "node --test tools/typescript-quality/verify.test.mjs tools/oxlint/verify-consumer.mts",
    "format:check": "oxfmt --check .",
    "typecheck:lint-tools": "tsc -p tools/oxlint/tsconfig.json"
  },
  "keywords": [
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Gristmill",
    "url": "https://github.com/timurkhakhalev"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "4.1.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@oxlint/plugins": "1.86.0",
    "@radix-ui/react-direction": "1.1.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@types/node": "24.13.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0",
    "esbuild": "0.28.1",
    "globals": "17.5.0",
    "knip": "6.37.0",
    "opencc-js": "^1.4.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "tiptap-markdown": "^0.9.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.4",
    "zustand": "^5.0.11"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.93",
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/azure": "^3.0.53",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/google-vertex": "^4.0.108",
    "@ai-sdk/groq": "^3.0.29",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/provider": "^3.0.14",
    "@aws-sdk/client-bedrock": "^3.1090.0",
    "@aws-sdk/credential-providers": "^3.1029.0",
    "@napi-rs/keyring": "^1.3.0",
    "ai": "^6.0.116",
    "better-sqlite3": "12.9.0",
    "dotenv": "^17.4.1",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.3.6",
    "onnxruntime-node": "^1.21.0",
    "ps-list": "^9.0.0",
    "tar": "^7.5.22",
    "tinfoil": "^1.1.8",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.12.3",
    "ws": "8.21.0",
    "zod": "^4.3.6"
  }
}
