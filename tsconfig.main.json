{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-main",
    "strict": true,
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "main.ts",
    "preload.ts",
    "src/workers/*.ts",
    "src/utils/audioUtils.ts",
    "src/helpers/appVersion.ts",
    "src/helpers/appChannel.ts",
    "src/helpers/audioActivityDetector.ts",
    "src/helpers/audioTapManager.ts",
    "src/helpers/autoStart.ts",
    "src/helpers/autoStartPolicy.ts",
    "src/helpers/debugLogger.ts",
    "src/helpers/devServerManager.ts",
    "src/helpers/devSnapshot.ts",
    "src/helpers/devAssetInstaller.ts",
    "src/helpers/dockManager.ts",
    "src/helpers/dockPolicy.ts",
    "src/helpers/dragManager.ts",
    "src/helpers/externalUrlOpener.ts",
    "src/helpers/globeKeyManager.ts",
    "src/helpers/hotkeyList.ts",
    "src/helpers/hotkeyManager.ts",
    "src/helpers/hotkeyRepeatGate.ts",
    "src/helpers/i18nMain.ts",
    "src/helpers/menuManager.ts",
    "src/helpers/navigationGuard.ts",
    "src/helpers/notificationTimer.ts",
    "src/helpers/onboardingWindowBounds.ts",
    "src/helpers/tray.ts",
    "src/helpers/windowBroadcast.ts",
    "src/helpers/windowConfig.ts",
    "src/helpers/windowManager.ts",
    "src/helpers/meetingAudioActivityMonitor.ts",
    "src/helpers/meetingAudioTimeline.ts",
    "src/helpers/meetingCoordinatorIpcHandlers.ts",
    "src/helpers/meetingDiarizationInput.ts",
    "src/helpers/meetingDiarizationPublication.ts",
    "src/helpers/meetingEchoLeakDetector.ts",
    "src/helpers/meetingMicGate.ts",
    "src/helpers/meetingMicHoldback.ts",
    "src/helpers/meetingSystemAudioWatchdog.ts",
    "src/helpers/systemDefaultMicrophone.ts",
    "src/helpers/whisperVadModel.ts",
    "src/helpers/companionNativeHost.ts",
    "src/helpers/companionServer.ts",
    "src/helpers/installCompanionHost.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-main",
    "src/dist",
    "test"
  ]
}
