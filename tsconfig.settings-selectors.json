{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": []
  },
  "include": [
    "src/contracts/inferenceSettings.ts",
    "src/config/settingsSelectors.ts",
    "src/config/bbAgentPreferences.ts",
    "src/config/inferenceScopes.ts",
    "src/config/transcriptionCapabilities.ts",
    "src/helpers/reasoningRouting.ts",
    "src/helpers/meetingTranscriptionRouting.ts"
  ]
}
